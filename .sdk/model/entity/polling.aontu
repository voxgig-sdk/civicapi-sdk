# Entity: polling

main: kit: entity: polling: {

  alias: field: {}

  fields: [
    {
      name: "endDate"
      req: false
      type: "`$STRING`"
    }
    {
      name: "marginOfError"
      req: false
      type: "`$NUMBER`"
    }
    {
      name: "pollId"
      req: false
      type: "`$STRING`"
    }
    {
      name: "pollster"
      req: false
      type: "`$STRING`"
    }
    {
      name: "results"
      req: false
      type: "`$ARRAY`"
    }
    {
      name: "sampleSize"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "startDate"
      req: false
      type: "`$STRING`"
    }
  ]

  name: "polling"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                example: "2024-presidential"
                kind: "query"
                name: "election_id"
                orig: "election_id"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: "2024-12-31"
                kind: "query"
                name: "end_date"
                orig: "end_date"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: "2024-01-01"
                kind: "query"
                name: "start_date"
                orig: "start_date"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: "CA"
                kind: "query"
                name: "state"
                orig: "state"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/api/polling"
          parts: [
            "api"
            "polling"
          ]
          select: {
            exist: [
              "election_id"
              "end_date"
              "start_date"
              "state"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.polls`"
          }
        }
      ]
    }
  }



}
