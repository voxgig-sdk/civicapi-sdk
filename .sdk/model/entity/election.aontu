      n: "name"
      r: false
      sh: "Election name"
      t: "`$STRING`"
    }
    state: {
      h: "State"
      n: "state"
      r: false
      sh: "State or jurisdiction"
      t: "`$STRING`"
    }
    status: {
      h: "Status"
      n: "status"
      r: false
      sh: "Current status of the election"
      t: "`$STRING`"
    }
    type: {
      h: "Type"
      n: "type"
