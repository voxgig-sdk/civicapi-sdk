  }

  id: {
    field: "id"
    name: "id"
  }

  name: "election"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /api/elections"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                ex: "CA"
                k: "query"
