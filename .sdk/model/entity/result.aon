# Entity: result

main: kit: entity: result: {

  alias: field: {}

  fields: [
    {
      name: "candidate"
      req: false
      short: "Candidate name"
      type: "`$STRING`"
    }
    {
      name: "party"
      req: false
      short: "Political party"
      type: "`$STRING`"
    }
    {
      name: "percentage"
      req: false
      short: "Percentage of total votes"
      type: "`$NUMBER`"
    }
    {
      name: "votes"
      req: false
      short: "Number of votes received"
      type: "`$INTEGER`"
    }
  ]

  name: "result"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                example: "Los Angeles"
                kind: "query"
                name: "county"
                orig: "county"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: "2024-presidential"
                kind: "query"
                name: "election_id"
                orig: "election_id"
                reqd: true
                type: "`$STRING`"
              }
              {
                example: "CA"
                kind: "query"
                name: "state"
                orig: "state"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/api/results"
          parts: [
            "api"
            "results"
          ]
          select: {
            exist: [
              "county"
              "election_id"
              "state"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.results`"
          }
        }
      ]
    }
  }



}
