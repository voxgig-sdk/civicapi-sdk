# Entity: election

main: kit: entity: election: {

  alias: field: {}

  fields: [
    {
      name: "date"
      req: false
      short: "Election date"
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      short: "Unique election identifier"
      type: "`$STRING`"
    }
    {
      name: "name"
      req: false
      short: "Election name"
      type: "`$STRING`"
    }
    {
      name: "state"
      req: false
      short: "State or jurisdiction"
      type: "`$STRING`"
    }
    {
      name: "status"
      req: false
      short: "Current status of the election"
      type: "`$STRING`"
    }
    {
      name: "type"
      req: false
      short: "Type of election"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "election"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                example: "CA"
                kind: "query"
                name: "state"
                orig: "state"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "type"
                orig: "type"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: 2024
                kind: "query"
                name: "year"
                orig: "year"
                reqd: false
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/api/elections"
          parts: [
            "api"
            "elections"
          ]
          select: {
            exist: [
              "state"
              "type"
              "year"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.elections`"
          }
        }
      ]
    }
  }



}
